{
  "name": "csc-questionnaire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:staging": "opennextjs-cloudflare build && wrangler deploy --env staging",
    "deploy:prod": "opennextjs-cloudflare build && wrangler deploy --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
    "seed:sql": "tsx scripts/build-seed-sql.ts",
    "seed:local": "pnpm seed:sql && wrangler d1 execute DB --local --file drizzle/seed/0001_forms.sql",
    "seed:staging": "pnpm seed:sql && wrangler d1 execute DB --env staging --remote --file drizzle/seed/0001_forms.sql",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "docs:generate": "tsx scripts/build-data-dictionary.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@notionhq/client": "5.26.0",
    "@opennextjs/cloudflare": "1.20.6",
    "drizzle-orm": "0.45.2",
    "libphonenumber-js": "1.13.12",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.26.0",
    "server-only": "0.0.1",
    "ulid": "3.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  },
  "packageManager": "pnpm@10.33.0"
}
